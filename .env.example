# Local development. Copy to .env and fill in; `npm run dev` loads it.
PUBLIC_URL=http://localhost:8787
PORT=8787
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
# Optional: Azure Table storage (uses your az login / managed identity). Omit for in-memory.
# AZURE_TABLE_ENDPOINT=https://<account>.table.core.windows.net
# Optional: comma-separated personal accounts allowed to connect. Omit to allow any personal account.
# ALLOWED_USERS=user@example.com
