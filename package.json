{
  "name": "outlook-remote-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Remote (Streamable HTTP) MCP server for personal Outlook.com accounts, with multi-user OAuth.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "npm run build && node --env-file=.env dist/index.js",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@azure/data-tables": "^13.3.2",
    "@azure/identity": "^4.13.3",
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
